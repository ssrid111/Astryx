<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="Astryx.uss" /><ui:VisualElement class="stage" name="stage"><ui:VisualElement class="panel oxygen" name=""><ui:Label text="OXYGEN  78%" class="heading" name="oxygen-label" /><ui:VisualElement class="oxygen-track" name=""><ui:VisualElement class="oxygen-fill" name="oxygen-fill"></ui:VisualElement></ui:VisualElement><ui:Label text="STABLE • O₂" class="small" name="" /></ui:VisualElement><ui:VisualElement class="panel objectives" name=""><ui:Label text="RESTORE THE POWER" class="heading" name="" /><ui:Label text="Find fuse + energy cell" class="body" name="objective" /><ui:Button text="Ⅱ" name="pause-open" class="" /></ui:VisualElement><ui:VisualElement class="panel quick" name=""><ui:Label text="QUICK INVENTORY" class="small" name="" /><ui:VisualElement class="row" name=""><ui:Button text="TOOL" name="slot-0" class="slot" /><ui:Button text="FUSE" name="slot-1" class="slot" /><ui:Button text="CELL" name="slot-2" class="slot" /><ui:Button text="—" name="slot-3" class="slot" /><ui:Button text="—" name="slot-4" class="slot" /></ui:VisualElement><ui:Button text="OPEN INVENTORY" name="inventory-open" class="" /></ui:VisualElement><ui:Button text="FATE ROULETTE" name="fate-open" class="fate-open" /><ui:Label text="E • Inspect power console" class="prompt" name="console-prompt" /><ui:Button text="REPAIR CONSOLE" name="puzzle-open" class="console-button" /><ui:VisualElement class="overlay hidden" name="intro"><ui:VisualElement class="panel modal" name=""><ui:Label text="LEVEL 01 / ASTRYX" class="eyebrow" name="" /><ui:Label text="Restore the Power" class="title" name="" /><ui:Label text="The ship is quiet. Your oxygen won’t last forever." class="body" name="" /><ui:Label text="Collect a fuse and energy cell. Repair the circuit. Unlock the exit." class="body" name="" /><ui:VisualElement class="row" name=""><ui:VisualElement class="icon astronaut" name=""></ui:VisualElement><ui:VisualElement class="steps" name=""><ui:Label text="01   Find the missing parts" class="body" name="" /><ui:Label text="02   Connect the circuit" class="body" name="" /><ui:Label text="03   Restore the power" class="body" name="" /></ui:VisualElement></ui:VisualElement><ui:Button text="START MISSION" name="start" class="" /></ui:VisualElement></ui:VisualElement><ui:VisualElement class="overlay hidden" name="inventory"><ui:VisualElement class="panel modal" name=""><ui:Label text="EQUIPMENT / 3 OF 5 SLOTS" class="eyebrow" name="" /><ui:Label text="Your inventory" class="title" name="" /><ui:VisualElement class="row" name=""><ui:VisualElement class="item" name=""><ui:VisualElement class="icon tool" name=""></ui:VisualElement><ui:Button text="Repair tool" name="inspect-tool" class="" /></ui:VisualElement><ui:VisualElement class="item" name=""><ui:VisualElement class="icon fuse" name=""></ui:VisualElement><ui:Button text="Power fuse" name="inspect-fuse" class="" /></ui:VisualElement><ui:VisualElement class="item" name=""><ui:VisualElement class="icon cell" name=""></ui:VisualElement><ui:Button text="Energy cell" name="inspect-cell" class="" /></ui:VisualElement></ui:VisualElement><ui:Label text="Select an item to inspect it." class="body" name="item-detail" /><ui:Button text="BACK TO SHIP" name="inventory-close" class="" /></ui:VisualElement></ui:VisualElement><ui:VisualElement class="overlay hidden" name="roulette"><ui:VisualElement class="panel modal" name=""><ui:Label text="THE VOID DECIDES YOUR FATE" class="eyebrow" name="" /><ui:Label text="Fate Roulette" class="title" name="" /><ui:VisualElement class="row" name=""><ui:VisualElement class="wheel-column" name=""><ui:VisualElement class="pointer" name=""></ui:VisualElement><ui:VisualElement class="wheel" name="wheel"></ui:VisualElement><ui:Button text="SPIN" name="spin" class="" /></ui:VisualElement><ui:VisualElement class="result" name=""><ui:Label text="One free spin per mission." class="body" name="result-type" /><ui:Label text="Feeling lucky?" class="title" name="result-title" /><ui:Label text="4 helpful and 4 harmful outcomes." class="body" name="result-detail" /><ui:Label text="Helpful: immunity, time, hint, tool" class="small" name="" /><ui:Label text="Harmful: resource loss, equipment failure, reduced vision, hazard" class="small" name="" /><ui:Button text="ACCEPT FATE" name="fate-close" class="" /></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement><ui:VisualElement class="overlay hidden" name="puzzle"><ui:VisualElement class="panel modal" name=""><ui:Label text="REPAIR CONSOLE / ROTATE THE TILES" class="eyebrow" name="" /><ui:Label text="Connect the circuit" class="title" name="" /><ui:VisualElement class="row" name=""><ui:VisualElement class="grid" name=""><ui:VisualElement class="row" name=""><ui:Button text="┗" name="tile-0" class="tile" /><ui:Button text="┗" name="tile-1" class="tile" /><ui:Button text="┗" name="tile-2" class="tile" /></ui:VisualElement><ui:VisualElement class="row" name=""><ui:Button text="┗" name="tile-3" class="tile" /><ui:Button text="┗" name="tile-4" class="tile" /><ui:Button text="┗" name="tile-5" class="tile" /></ui:VisualElement><ui:VisualElement class="row" name=""><ui:Button text="┗" name="tile-6" class="tile" /><ui:Button text="┗" name="tile-7" class="tile" /><ui:Button text="┗" name="tile-8" class="tile" /></ui:VisualElement></ui:VisualElement><ui:VisualElement class="result" name=""><ui:Label text="SOURCE: left of upper-left tile" class="body" name="" /><ui:Label text="CORE: right of lower-right tile" class="body" name="" /><ui:Label text="Fuse installed • Cell installed" class="body" name="" /><ui:Label text="Join one unbroken path." class="body" name="circuit-status" /><ui:Button text="TEST CIRCUIT" name="test-circuit" class="" /><ui:Button text="BACK TO SHIP" name="puzzle-close" class="" /></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement><ui:VisualElement class="overlay hidden" name="pause"><ui:VisualElement class="panel modal" name=""><ui:Label text="MISSION PAUSED / OXYGEN FROZEN" class="eyebrow" name="" /><ui:Label text="Take a breather" class="title" name="" /><ui:Label text="Your progress is safe while this menu is open." class="body" name="" /><ui:Button text="RESUME" name="resume" class="" /><ui:Button text="RESTART MISSION" name="restart" class="" /><ui:Button text="EXIT TO TITLE" name="exit" class="" /></ui:VisualElement></ui:VisualElement><ui:VisualElement class="overlay hidden" name="complete"><ui:VisualElement class="panel modal" name=""><ui:Label text="LEVEL 01 / MISSION COMPLETE" class="eyebrow" name="" /><ui:Label text="Power restored!" class="title" name="" /><ui:VisualElement class="icon star" name=""></ui:VisualElement><ui:Label text="The lights are on. The exit is open." class="body" name="" /><ui:Label text="Oxygen remaining: 78% • Circuit repaired ✓" class="body" name="summary" /><ui:Button text="CONTINUE TO LEVEL 2" name="continue" class="" /><ui:Button text="REPLAY" name="replay" class="" /></ui:VisualElement></ui:VisualElement><ui:VisualElement class="overlay hidden" name="gameover"><ui:VisualElement class="panel modal" name=""><ui:Label text="MISSION FAILED / TRY AGAIN" class="eyebrow" name="" /><ui:Label text="Out of oxygen" class="title" name="" /><ui:VisualElement class="icon oxygen" name=""></ui:VisualElement><ui:Label text="The ship still needs you. Collect both parts before repairing." class="body" name="" /><ui:Button text="TRY AGAIN" name="retry" class="" /><ui:Button text="EXIT TO TITLE" name="gameover-exit" class="" /></ui:VisualElement></ui:VisualElement><ui:VisualElement class="overlay hidden" name="confirm"><ui:VisualElement class="panel modal" name=""><ui:Label text="Restart mission?" class="title" name="" /><ui:Label text="This resets the demo oxygen, circuit and roulette spin." class="body" name="" /><ui:Button text="RESTART" name="confirm-restart" class="" /><ui:Button text="CANCEL" name="cancel-restart" class="" /></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:UXML>