
:root { --ink: #24234B; --cream: #FFF5DA; --purple: #773EE5; }
.stage { flex-grow: 1; background-image: url('../../Sprites/UI/Art/ship-backdrop.png'); -unity-background-scale-mode: scale-and-crop; color: var(--ink); }
.panel { background-color: var(--cream); border-color: var(--ink); border-width: 4px; border-radius: 22px; padding: 24px; }
Label { white-space: normal; margin-bottom: 16px; font-size: 26px; }
.title { font-size: 52px; -unity-font-style: bold; margin-bottom: 24px; }
.heading { font-size: 25px; -unity-font-style: bold; }
.eyebrow, .small { font-size: 20px; -unity-font-style: bold; }
Button { background-color: var(--purple); color: var(--cream); border-color: var(--ink); border-width: 4px; border-radius: 16px; min-height: 64px; padding: 12px 24px; font-size: 25px; -unity-font-style: bold; margin: 8px; }
Button:hover { background-color: #9259F3; }
Button:active { background-color: #5427B8; }
Button:focus { border-color: #E19B00; border-width: 6px; }
Button:disabled { background-color: #85809D; color: #FFFFFF; }
.hidden { display: none; }
.row { flex-direction: row; align-items: center; justify-content: space-between; }
.oxygen { position: absolute; top: 36px; left: 44px; width: 350px; }
.objectives { position: absolute; top: 36px; right: 44px; width: 480px; }
.oxygen-track { height: 22px; background-color: #D8D9CB; border-radius: 12px; margin-bottom: 12px; }
.oxygen-fill { height: 100%; width: 78%; background-color: #55DBB0; border-radius: 12px; }
.quick { position: absolute; bottom: 24px; left: 29%; width: 42%; padding: 12px; }
.slot { width: 17%; min-width: 0; padding: 4px; font-size: 19px; background-color: #E5DCF7; color: var(--ink); }
.fate-open { position: absolute; right: 44px; bottom: 36px; }
.prompt { position: absolute; top: 64%; left: 38%; background-color: var(--cream); padding: 16px; border-radius: 14px; }
.console-button { position: absolute; right: 24%; bottom: 26%; }
.overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgba(36,35,75,0.70); align-items: center; justify-content: center; }
.modal { width: 1120px; max-width: 94%; padding: 48px; }
.icon { width: 140px; height: 140px; -unity-background-scale-mode: scale-to-fit; }
.astronaut { width: 210px; height: 260px; background-image: url('../../Sprites/UI/Art/astronaut.png'); }
.steps { flex-grow: 1; padding: 36px; }
.item { width: 30%; align-items: center; background-color: #E5DCF7; border-radius: 20px; padding: 18px; margin-bottom: 24px; }
.result { width: 52%; padding: 24px; }
.wheel-column { width: 440px; align-items: center; }
.wheel { width: 400px; height: 400px; background-image: url('../../Sprites/UI/Art/wheel.png'); }
.pointer { width: 24px; height: 24px; background-color: #FFD447; border-radius: 12px; border-color: var(--ink); border-width: 4px; }
.tile { width: 108px; height: 108px; font-size: 65px; padding: 0; background-color: #203C7A; color: #FFD447; }
.fuse { background-image: url('../../Sprites/UI/Art/fuse.png'); }
.tool { background-image: url('../../Sprites/UI/Art/tool.png'); }
.cell { background-image: url('../../Sprites/UI/Art/cell.png'); }
.star { background-image: url('../../Sprites/UI/Art/star.png'); }
.bolt { background-image: url('../../Sprites/UI/Art/bolt.png'); }

#roulette > .modal { background-color: #341963; color: #FFF5DA; border-color: #9259F3; }
#roulette .result { background-color: #FFF5DA; color: #24234B; border-radius: 20px; }

/* Fate Roulette only: keep the other level screens unchanged. */
#roulette .roulette-modal { width: 1120px; max-height: 96%; padding: 22px 28px; }
#roulette .eyebrow { font-size: 16px; margin-bottom: 4px; }
#roulette .title { font-size: 36px; margin-bottom: 6px; }
#roulette .roulette-rule { font-size: 18px; margin-bottom: 8px; }
#roulette .roulette-content { align-items: center; }
#roulette .wheel-column { width: 40%; flex-shrink: 0; }
#roulette .wheel { width: 260px; height: 260px; flex-shrink: 0; }
#roulette .roulette-pointer { width: 24px; height: 24px; rotate: 45deg; background-color: #FFD447; border-color: #24234B; border-width: 3px; margin-bottom: -12px; }
#roulette .wheel-number { position: absolute; width: 26px; height: 26px; margin-left: -13px; margin-top: -13px; margin-bottom: 0; border-radius: 13px; background-color: #FFF5DA; color: #24234B; font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center; }
#roulette .roulette-caption { font-size: 16px; -unity-text-align: middle-center; margin-bottom: 0; }
#roulette .roulette-result { width: 57%; padding: 22px; border-color: #24234B; border-width: 3px; }
#roulette .roulette-status { font-size: 18px; -unity-font-style: bold; margin-bottom: 10px; }
#roulette .roulette-result-title { font-size: 30px; }
#roulette .roulette-detail { font-size: 20px; min-height: 88px; margin-bottom: 12px; }
#roulette .roulette-note { font-size: 18px; margin-bottom: 10px; }
#roulette .roulette-legend { margin-top: 12px; align-items: stretch; }
#roulette .roulette-outcomes { width: 49%; padding: 10px 12px; background-color: #492875; border-radius: 14px; border-left-color: #55DBB0; border-left-width: 4px; }
#roulette .roulette-harmful { border-left-color: #FA858C; }
#roulette .roulette-group-title { font-size: 16px; -unity-font-style: bold; margin-bottom: 8px; }
#roulette .roulette-outcome { font-size: 15px; margin-bottom: 4px; }

#roulette Button { min-height: 56px; font-size: 22px; padding: 10px 18px; }

/* Phase 2: backend-aware UI. The gameplay scene remains visible behind the HUD. */
.stage.live-world { background-image: none; background-color: rgba(0, 0, 0, 0); }
.backend-hud { position: absolute; top: 36px; left: 38%; width: 28%; padding: 14px 18px; }
.backend-hud .heading { font-size: 21px; margin-bottom: 6px; }
.backend-hud .small { font-size: 16px; margin-bottom: 0; }
.backend-banner { position: absolute; left: 24px; bottom: 16px; max-width: 26%; background-color: #FFF5DA; color: #24234B; padding: 12px; border-radius: 12px; font-size: 16px; }
.backend-inventory { max-height: 290px; margin-bottom: 16px; }
.backend-item { background-color: #E5DCF7; border-color: #24234B; border-width: 2px; border-radius: 12px; margin-bottom: 8px; padding: 12px 18px; }
.backend-item Label { font-size: 21px; margin-bottom: 4px; }
.backend-item.locked { background-color: #F8D9DB; }
.backend-item .small { font-size: 17px; }
.slot.locked { background-color: #F8D9DB; color: #6B223F; }
.save-actions Button { width: 46%; }
#save-status { font-size: 18px; }
#pause .modal { padding: 28px 36px; }
#pause .title { font-size: 40px; margin-bottom: 14px; }
#pause Label { margin-bottom: 12px; }
.live-world .objectives { width: 30%; right: 24px; padding: 16px; }
.live-world .objectives .heading { font-size: 22px; }
.live-world .objectives .body { font-size: 21px; }
.live-world .oxygen { width: 27%; left: 24px; padding: 16px; }
.live-world .quick { left: 27%; width: 46%; bottom: 18px; }
.live-world .console-button { display: none; }
.live-world .prompt { top: auto; bottom: 220px; left: 25%; max-width: 60%; font-size: 22px; }

.backend-connected .modal { padding: 26px 32px; max-height: 96%; }
.backend-connected .modal .title { font-size: 36px; margin-bottom: 12px; }
.backend-connected .modal .body { font-size: 22px; margin-bottom: 12px; }
.backend-connected .modal Button { min-height: 52px; font-size: 21px; padding: 8px 16px; }
.backend-connected .astronaut { height: 170px; width: 150px; }
.backend-connected .steps { padding: 18px; }
.backend-connected .quick Button { min-height: 42px; font-size: 17px; padding: 4px; }
.backend-connected .slot { white-space: normal; }
.backend-connected .backend-banner { max-width: 24%; font-size: 14px; }
.backend-connected #exit, .backend-connected #gameover-exit { margin-top: 4px; }
/* Compact HUD also applies to the fate-system scene's 1200 × 800 reference canvas. */
.backend-connected .objectives { width: 30%; right: 24px; padding: 16px; }
.backend-connected .objectives .heading { font-size: 22px; }
.backend-connected .objectives .body { font-size: 21px; }
.backend-connected #pause-open { align-self: flex-end; width: 70px; min-height: 40px; font-size: 20px; padding: 4px; }
.backend-connected .oxygen { width: 27%; left: 24px; padding: 16px; }
.backend-connected .quick { left: 27%; width: 46%; bottom: 18px; }
.backend-connected .backend-banner { width: 23%; max-width: 23%; font-size: 15px; }
.backend-connected .fate-open { width: 22%; right: 24px; bottom: 24px; min-height: 52px; font-size: 20px; }
.backend-connected .console-button { bottom: 29%; right: 28%; min-height: 52px; font-size: 20px; }
.backend-connected .prompt { display: none; }
.live-world .prompt { display: flex; }
.backend-connected .backend-banner { width: 260px; min-width: 260px; max-width: 260px; bottom: 18px; }
